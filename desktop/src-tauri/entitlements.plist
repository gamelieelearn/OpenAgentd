<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No hardened-runtime exceptions: the native sidecar does not JIT
         (QuickJS interprets plugins), loads no third-party dylibs, and needs
         no DYLD_* injection. The v2 Python sidecar needed all four; keep
         them out so the bundle keeps library validation. -->

    <!-- Required for the sidecar to bind 127.0.0.1 sockets and for the
         WebView to talk to it. The app does NOT need outgoing network
         access; the user's chosen LLM provider is reached *by the
         sidecar*, not by the WebView. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Required for user-chosen workspace directories. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
